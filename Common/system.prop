# ============================================
# RAM & ZRAM Optimization
# ============================================
persist.sys.purgeable_assets=1
ro.config.low_ram=false
persist.sys.zram_enabled=1
# Explicitly set ZRAM compression algorithm (zstd is faster than lzo/lz4 for gaming)
sys.zram.compression_algorithm=zstd
# Limit background apps to free up RAM for games
ro.sys.fw.bg_apps_limit=32
ro.sys.fw.trim_enable_memory=true
# Increase VM heap size for large games
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75

# ============================================
# CPU Performance
# ============================================
debug.performance.tuning=1
persist.sys.NV_FPSLIMIT=0
persist.sys.NV_POWERMODE=1
# Disable stereo controls (irrelevant for handheld)
persist.sys.NV_STEREO_CONTROL=0
persist.sys.NV_STEREO_EYES=0

# ============================================
# GPU Optimization (Adreno)
# ============================================
# Triple buffering for smoother frame pacing
debug.egl.buffcount=3
# Disable VSync wait for swap (reduces input lag)
debug.egl.swapinterval=0
persist.sys.ui.hw=1
debug.egl.hw=1
ro.product.gpu.driver=1
video.accelerate.hw=1
debug.gr.swapinterval=0
persist.sys.use_dithering=0
# Enable UBWC (Unified Buffer Cache) for better memory bandwidth
debug.gralloc.gfx_ubwc_disable=0
# Force GPU rendering for UI
debug.sf.hw=1
debug.sf.latch_unsignaled=1

# ============================================
# Display & Touch (Handheld Specific)
# ============================================
vendor.perf.framepacing.enable=1
ro.vendor.display.type=oled
vendor.display.vds_allow_hwc=1
vendor.display.enable_optimize_refresh=1
vendor.display.use_smooth_motion=1
# Reduce idle time to prevent screen dimming lag
vendor.display.idle_time=0
debug.sf.treat_170m_as_sRGB=1

# Touch responsiveness
persist.sys.scrollingcache=0
ro.max.fling_velocity=30000
ro.min.fling_velocity=12000
ro.min_pointer_dur=8
sys.use_fifo_ui=1
windowsmgr.max_event_per_sec=1000
touch.size.calibration=geometric
touch.pressure.scale=0.001
persist.sys.ui.hw=true
persist.sys.force_hw_ui=true

# ============================================
# Qualcomm/Snapdragon Specific
# ============================================
debug.qctwa.statusbar=1
debug.qctwa.preservebuf=1

# ============================================
# 3D & Rendering
# ============================================
hw3d.force=1
hw2d.force=1

# ============================================
# Cleanup & Misc
# ============================================
persist.service.lgospd.enable=0
persist.service.pcsync.enable=0
debug.egl.force_msaa=false
debug.egl.profiler=0
